<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- GitHub Webhook Form -->
        <record id="github_webhook_form" model="ir.ui.view">
            <field name="name">github.webhook.form</field>
            <field name="model">github.webhook</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="event_type" />
                            <field name="status" />
                            <field name="timestamp" />
                        </group>
                        <field name="payload" widget="json" />
                        <field name="error_message" />
                    </sheet>
                </form>
            </field>
        </record>

        <!-- GitHub Webhook Tree -->
        <record id="github_webhook_tree" model="ir.ui.view">
            <field name="name">github.webhook.tree</field>
            <field name="model">github.webhook</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="event_type" />
                    <field name="timestamp" />
                    <field name="status" />
                </tree>
            </field>
        </record>

        <!-- GitHub Webhook Action -->
        <record id="action_github_webhook" model="ir.actions.act_window">
            <field name="name">GitHub Webhooks</field>
            <field name="res_model">github.webhook</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Menu Item -->
        <menuitem
            id="menu_github_webhooks"
            name="GitHub Webhooks"
            parent="menu_github_oauth"
            action="action_github_webhook"
            sequence="51"
        />
    </data>
</odoo>
